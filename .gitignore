# build output
target/
dist/

# map packs (game-derived geometry/textures — never redistribute)
packs/
*.eftpack/
*.eftpack
eft_assets/
tarkmap/out/
/out/

# game-extracted map assets — belt-and-suspenders so extracted geometry/textures/scenes can
# NEVER be committed even if the pipeline writes loose files inside the tree (the dirs above
# cover the normal locations; these catch stray files anywhere). None of these types have a
# legitimate place in a Rust/Python source tree — they are always game-derived output.
*.obj
*.glb
*.gltf
*.fbx
*.dds
*.ktx
*.ktx2
*.basis
*.tga
scene.json
meshes.bin
volume.bin
volume.json
vis.bin
grass_density_*.bin

# transient build/staging dirs
*.building/
*.old/
# ad-hoc test-worktree scratch (throwaway probe scripts, timing logs, trial packs + the
# tarkov.dev json caches they pull). 1.8 GB; the *.eftpack rules above already catch most of
# it, so without this the leftovers look small and committable when they are not source.
_tw/
# Blender addon workspace (binary rigs/animations, 30 MB) — not part of the viewer build.
.blender-toolkit/

# local config & secrets
atlas.config.json
.env
.env.*
!.env.example
scripts/build-all-atlas-maps.local.psd1
scripts/build-all-atlas-maps.running

# python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
venv/
.venv/

# logs & editor
*.log
.vscode/
.idea/

# working notes: per-investigation audits/plans/specs dropped at the repo root. They go stale the
# moment the work lands and then read as current guidance, so they stay local. Anything durable
# belongs in docs/ (see docs/GAME_DATA_EXTRACTION.md) or in a code comment next to the thing it
# explains. Root-anchored so docs/ and the tracked top-level READMEs are unaffected.
/*_AUDIT.md
/*_PLAN.md
/*_SPEC.md
/*_BRIEF.md
/*_FINDINGS.md
/*_DESIGN.md
# one-off probe scripts (the repo's leading-underscore = scratch convention)
tools/_*
docs/_bench_logs/
# the viewer's double-click geometry probe dumps the picked instance here
pick.json
# scratch cargo target dirs from side-by-side builds (the real one is already ignored above)
target_*/

# No markdown in the repo: docs live locally only (working notes, not shippables).
# Exception: the README (release landing page).
*.md
!README.md
!third_party/**/README.md
# Exception: docs/extraction/. Unlike a working note these describe the pipeline's invariants
# rather than one investigation, they are verified against the source they document, and they are
# only useful to a contributor if they arrive with the code that has to obey them. Kept in plain
# markdown at a neutral path so an importer author, a person, or any agent reads the same source;
# .claude/skills/ holds only a discovery shim pointing here.
!docs/extraction/**/*.md
!.claude/skills/**/*.md

# GAME CONTENT — never tracked. The grade LUT source is extracted verbatim from the
# game's resources.assets and its .bin is that asset's derivative; both are rebuilt
# locally by extraction/grade/make_grade_lut_game.py.
extraction/grade/lut_amidgen_bluegreen.png
extraction/grade/eft_grade_lut.bin
extraction/grade/eft_grade_lut_recon.bin
